# Tastamam — ortam değişkenleri. Bu dosyayı .env.local adıyla kopyala ve doldur.
# Ayrıntılı kurulum: KURULUM.md

# --- Supabase (zorunlu) ---
# Proje ayarları → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Yalnızca sunucuda ve ilk admin betiğinde kullanılır, tarayıcıya gitmez.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Yalnızca `npm run kur` (veritabanı tablolarını kurar/günceller) kullanır.
# Supabase → Connect → Session pooler bağlantı adresi; şifreyi içine yaz.
# Docker ile yerel Supabase'de: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Uygulamanın adresi (maillerdeki bağlantılar). Domain bağlarsan https://ik.sirketin.com
UYGULAMA_ADRESI=http://localhost:3000

# --- Mail (zorunlu: muhasebe mailleri ve gelen kutusu taraması) ---
SMTP_HOST=mail.sirketin.com
SMTP_PORT=465
SMTP_USER=ik@sirketin.com
SMTP_PASS=
IMAP_HOST=mail.sirketin.com
IMAP_PORT=993
# Gelen kutusu sunucusunun Authentication-Results kimliği (authserv-id): muhasebeden gelen
# bir mailin kaynağında en üstteki "Authentication-Results: <bu-değer>;" satırı. Boşsa
# gelen belgeler otomatik dosyalanmaz, hepsi elle onaya düşer (taklit From'a karşı).
MAIL_DOGRULAYICI=

# --- Belge deposu ---
# supabase (varsayılan) | onedrive | gdrive | yerel. Sonradan değiştirirsen eski belgeler taşınmaz.
DEPO_SAGLAYICI=supabase
# Özlük klasörlerinin depodaki kökü (altında AKTİF/ ve PASİF/ açılır).
OZLUK_KOK=Özlük
# Supabase Storage bucket adı (migration 0020 "ozluk" adıyla açar).
SUPABASE_DEPO_BUCKET=ozluk

# --- OneDrive eklentisi (DEPO_SAGLAYICI=onedrive ise) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Google Drive eklentisi (DEPO_SAGLAYICI=gdrive ise) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Boşsa "Drive'ım" kökü kullanılır; bir klasörün adresindeki id'yi yazabilirsin.
GDRIVE_KOK_KLASOR_ID=

# --- Bu bilgisayar (DEPO_SAGLAYICI=yerel ise) ---
# Belgelerin yazılacağı klasörün tam yolu. Yalnızca uygulamayı kendi
# bilgisayarında/sunucunda çalıştırırken (npm start) çalışır; Netlify/Vercel'de olmaz.
# Örnek: C:\Users\ad\OneDrive\Şirket  ya da  /home/ad/tastamam-belgeler
YEREL_DEPO_KOK=
